# ── Chatlly Backend — Production Environment (Railway) ──
# Set these in the Railway dashboard. Never commit real values.

# DeepSeek API key (required — the bots will not work without it)
DEEPSEEK_API_KEY=

# JWT signing secret — MUST be a long random string in production.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Admin + control panel login (same identity for both)
ADMIN_USERNAME=Mikeygold
ADMIN_PASSWORD=
PANEL_USERNAME=Mikeygold
PANEL_PASSWORD=

# The deployed frontend URL — locks CORS to your domain.
# Example: https://chatlly.vercel.app   (do NOT use * in production)
FRONTEND_URL=

# Persistent volume mount path. Railway: add a Volume and mount it at /data
# so bans, users and chat history survive restarts and redeploys.
DATA_DIR=/data

# Railway injects PORT automatically — leave this unset there.
# PORT=3900
